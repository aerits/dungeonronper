&"compress/lossy_quality": 0.0,
&"compress/mode": 4,
&"compress/rdo_quality_loss": 10.0
}
scene={
&"meshes/create_shadow_meshes": false,
&"meshes/generate_lods": false
}
cubemap_array_texture={
&"compress/lossy_quality": 0.0,
&"compress/mode": 4,
&"compress/rdo_quality_loss": 10.0
}
cubemap_texture={
&"compress/lossy_quality": 0.0,
&"compress/mode": 4,
&"compress/rdo_quality_loss": 10.0
}

